{
  "name": "recipe-book",
  "version": "1.0.0",
  "private": true,
  "description": "Recipe book web app (frontend + backend).",
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "build": "npm run build -w backend && npm run build -w frontend",
    "test": "npm run test -w backend",
    "lint": "npm run lint -w backend && npm run lint -w frontend"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uaneere/recipe-book.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/uaneere/recipe-book/issues"
  },
  "homepage": "https://github.com/uaneere/recipe-book#readme",
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
